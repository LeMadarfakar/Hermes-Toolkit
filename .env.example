# Hermes Environment Configuration
# Copy to ~/.hermes/.env and fill in your API keys

# =============================================================================
# CONTEXT7 API KEY (required for Context7 MCP server)
# Get at: https://context7.com → API Keys
# =============================================================================
CONTEXT7_API_KEY=your_context7_api_key_here

# =============================================================================
# OPTIONAL: Other LLM Provider Keys (if you use them)
# =============================================================================
# NVIDIA_API_KEY=your_nvidia_key_here
# OPENROUTER_API_KEY=your_openrouter_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENAI_API_KEY=your_openai_key_here
# GOOGLE_API_KEY=your_google_key_here

# =============================================================================
# OPTIONAL: Browser Automation (if you use browser tools)
# =============================================================================
# BROWSERBASE_API_KEY=your_browserbase_key_here
# BROWSERBASE_PROJECT_ID=your_project_id_here

# =============================================================================
# OPTIONAL: Voice/STT/TTS
# =============================================================================
# VOICE_TOOLS_OPENAI_KEY=your_openai_key_for_voice
# GROQ_API_KEY=your_groq_key_for_whisper
# ELEVENLABS_API_KEY=your_elevenlabs_key

# =============================================================================
# OPTIONAL: GitHub (for skills hub, PRs, etc.)
# =============================================================================
# GITHUB_TOKEN=ghp_your_github_pat_here